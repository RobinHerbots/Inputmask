{
  "name": "@inputmask/jquery",
  "version": "0.1.0",
  "description": "jQuery plugin for Inputmask",
  "type": "module",
  "main": "./dist/jquery.inputmask.cjs",
  "module": "./dist/jquery.inputmask.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/jquery.inputmask.js",
      "require": "./dist/jquery.inputmask.cjs"
    },
    "./jquery.inputmask.umd.js": "./dist/jquery.inputmask.umd.js",
    "./jquery.inputmask.min.js": "./dist/jquery.inputmask.min.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && rollup -c && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "inputmask": "^5.1.0-beta.37",
    "jquery": ">=3.7.0"
  },
  "devDependencies": {
    "inputmask": "file:../..",
    "@types/jquery": "^3.5.0",
    "jquery": "^3.7.1",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}