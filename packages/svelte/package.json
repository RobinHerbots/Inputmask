{
  "name": "@inputmask/svelte",
  "version": "0.1.0",
  "description": "Svelte action for Inputmask",
  "type": "module",
  "main": "./dist/svelte.inputmask.cjs",
  "module": "./dist/svelte.inputmask.js",
  "types": "./dist/svelte.inputmask.d.ts",
  "exports": {
    ".": {
      "types": "./dist/svelte.inputmask.d.ts",
      "import": "./dist/svelte.inputmask.js",
      "require": "./dist/svelte.inputmask.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "inputmask": "^5.1.0-beta.37",
    "svelte": ">=4.0.0"
  },
  "devDependencies": {
    "inputmask": "file:../..",
    "jsdom": "^30.1.2",
    "svelte": "^5.57.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
