{
  "name": "inputmask",
  "version": "5.1.0-beta.27",
  "description": "Inputmask is a javascript library which creates an input mask.  Inputmask can run against vanilla javascript, jQuery and jqlite.",
  "main": "dist/inputmask.js",
  "module": "dist/esm/inputmask.mjs",
  "types": "dist/types/inputmask.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/inputmask.d.ts",
      "import": "./dist/esm/inputmask.mjs",
      "require": "./dist/inputmask.js"
    },
    "./extensions/date": {
      "types": "./lib/extensions/date.d.ts",
      "import": "./dist/esm/date.mjs"
    },
    "./extensions/numeric": {
      "types": "./lib/extensions/numeric.d.ts",
      "import": "./dist/esm/numeric.mjs"
    },
    "./extensions/definitions": {
      "types": "./dist/types/extensions/definitions.d.ts",
      "import": "./dist/esm/definitions.mjs"
    },
    "./extensions/cssunit": {
      "types": "./dist/types/extensions/cssunit.d.ts",
      "import": "./dist/esm/cssunit.mjs"
    },
    "./extensions/url": {
      "types": "./dist/types/extensions/url.d.ts",
      "import": "./dist/esm/url.mjs"
    },
    "./extensions/ip": {
      "types": "./dist/types/extensions/ip.d.ts",
      "import": "./dist/esm/ip.mjs"
    },
    "./extensions/email": {
      "types": "./dist/types/extensions/email.d.ts",
      "import": "./dist/esm/email.mjs"
    },
    "./extensions/mac": {
      "types": "./dist/types/extensions/mac.d.ts",
      "import": "./dist/esm/mac.mjs"
    },
    "./extensions/vin": {
      "types": "./dist/types/extensions/vin.d.ts",
      "import": "./dist/esm/vin.mjs"
    },
    "./extensions/ssn": {
      "types": "./dist/types/extensions/ssn.d.ts",
      "import": "./dist/esm/ssn.mjs"
    },
    "./colormask": {
      "types": "./dist/types/extensions/colormask.d.ts",
      "import": "./dist/esm/colormask.mjs",
      "require": "./dist/colormask.js"
    },
    "./inputmaskElement": {
      "types": "./dist/types/inputmaskElement.d.ts",
      "import": "./dist/esm/inputmaskElement.mjs"
    },
    "./dist/*": "./dist/*",
    "./lib/*": "./lib/*",
    "./micromasks/*": "./micromasks/*"
  },
  "files": [
    "Changelog.md",
    "dist/",
    "lib/",
    "micromasks/"
  ],
  "sideEffects": [
    "./bundle.js",
    "./bundle.jquery.js",
    "./bundle.colormask.js",
    "./lib/global/FormData.js",
    "./lib/inputmaskElement.js",
    "./lib/extensions/inputmask.date.i18n.js",
    "./lib/bindings/inputmask.binding.js"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "start": "webpack --progress --watch --config-name main --config webpack.config.js",
    "jquery": "webpack --progress --watch --config-name jquery --config webpack.config.js",
    "colormask": "webpack --progress --watch --config-name colormask --config webpack.config.js",
    "modern": "webpack --progress --watch --config-name modern --config webpack.config.js",
    "qunit": "webpack --progress --watch --config-name test --config webpack.config.js",
    "types": "tsc -p tsconfig.types.json --emitDeclarationOnly",
    "test": "grunt validate",
    "update-browserlist": "npx update-browserslist-db@latest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RobinHerbots/Inputmask.git"
  },
  "keywords": [
    "form",
    "input",
    "inputmask",
    "jquery",
    "jquery-plugin",
    "mask",
    "plugins"
  ],
  "author": {
    "name": "Robin Herbots",
    "url": "https://github.com/RobinHerbots"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RobinHerbots/Inputmask/issues"
  },
  "homepage": "https://github.com/RobinHerbots/Inputmask",
  "dependencies": {
    "core-js": "3.50.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@robinherbots/grunt-available-tasks": "^0.6.4",
    "@robinherbots/grunt-nuget": "^0.3.3",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^61.7.1",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "grunt": "^1.6.2",
    "grunt-bump": "^0.8.0",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-eslint": "^26.0.0",
    "grunt-karma": "^4.0.2",
    "grunt-release": "^0.14.0",
    "grunt-webpack": "^8.0.0",
    "jquery": "^3.7.1",
    "karma": "^6.4.4",
    "karma-browserstack-launcher": "^1.6.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-qunit": "^4.2.1",
    "load-grunt-tasks": "^5.1.0",
    "lodash": "^4.18.1",
    "prettier": "3.9.6",
    "qunit": "^2.26.0",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^5.9.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
