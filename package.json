{
  "name": "inputmask",
  "version": "5.1.0-beta.37",
  "description": "Inputmask is a javascript library which creates an input mask.  Inputmask can run against vanilla javascript, jQuery and jqlite.",
  "main": "dist/inputmask.js",
  "module": "dist/esm/inputmask.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/inputmask.mjs",
      "require": "./dist/inputmask.js"
    },
    "./extensions/date": {
      "types": "./dist/types/extensions/date.d.ts",
      "import": "./dist/esm/extensions/date.mjs"
    },
    "./extensions/date.i18n": {
      "import": "./dist/esm/extensions/date.i18n.mjs"
    },
    "./extensions/numeric": {
      "types": "./dist/types/extensions/numeric.d.ts",
      "import": "./dist/esm/extensions/numeric.mjs"
    },
    "./extensions/definitions": {
      "types": "./dist/types/extensions/definitions.d.ts",
      "import": "./dist/esm/extensions/definitions.mjs"
    },
    "./extensions/cssunit": {
      "types": "./dist/types/extensions/cssunit.d.ts",
      "import": "./dist/esm/extensions/cssunit.mjs"
    },
    "./extensions/url": {
      "types": "./dist/types/extensions/url.d.ts",
      "import": "./dist/esm/extensions/url.mjs"
    },
    "./extensions/ip": {
      "types": "./dist/types/extensions/ip.d.ts",
      "import": "./dist/esm/extensions/ip.mjs"
    },
    "./extensions/email": {
      "types": "./dist/types/extensions/email.d.ts",
      "import": "./dist/esm/extensions/email.mjs"
    },
    "./extensions/mac": {
      "types": "./dist/types/extensions/mac.d.ts",
      "import": "./dist/esm/extensions/mac.mjs"
    },
    "./extensions/vin": {
      "types": "./dist/types/extensions/vin.d.ts",
      "import": "./dist/esm/extensions/vin.mjs"
    },
    "./extensions/ssn": {
      "types": "./dist/types/extensions/ssn.d.ts",
      "import": "./dist/esm/extensions/ssn.mjs"
    },
    "./colormask": {
      "types": "./dist/types/extensions/colormask.d.ts",
      "require": "./dist/colormask.js"
    },
    "./inputmaskElement": {
      "types": "./dist/types/inputmaskElement.d.ts"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "Changelog.md",
    "dist/",
    "!dist/**/*.map"
  ],
  "sideEffects": [
    "./dist/*.js",
    "./dist/esm/**/*.mjs"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "node build.js",
    "build:watch": "node build.js --watch",
    "types": "tsc -p tsconfig.types.json --emitDeclarationOnly",
    "test": "npm run build && npm run types && npm run test:node && npm run lint && npm run test:jsdom",
    "test:node": "qunit qunit/tests_node.js",
    "test:jsdom": "karma start karma.conf.js --browsers jsdom --single-run",
    "test:jsdom:umd": "cross-env INPUTMASK_BUNDLE=umd karma start karma.conf.js --browsers jsdom --single-run",
    "test:jsdom:jquery": "cross-env INPUTMASK_BUNDLE=jquery karma start karma.conf.js --browsers jsdom --single-run",
    "test:jsdom:esm": "cross-env INPUTMASK_BUNDLE=esm karma start karma.conf.js --browsers jsdom --single-run",
    "test:jsdom:bundles": "npm run test:jsdom:umd && npm run test:jsdom:jquery && npm run test:jsdom:esm",
    "test:chrome": "karma start karma.conf.js --browsers ChromeHeadless --single-run",
    "test:umd": "cross-env INPUTMASK_BUNDLE=umd karma start karma.conf.js --browsers ChromeHeadless --single-run",
    "test:jquery": "cross-env INPUTMASK_BUNDLE=jquery karma start karma.conf.js --browsers ChromeHeadless --single-run",
    "test:esm": "cross-env INPUTMASK_BUNDLE=esm karma start karma.conf.js --browsers ChromeHeadless --single-run",
    "test:bundles": "npm run test:umd && npm run test:jquery && npm run test:esm",
    "test:browserstack": "cross-env CI=true karma start karma.conf.js --single-run",
    "lint": "eslint lib/**/*.js --ignore-pattern lib/.rollup/** --ignore-pattern lib/extensions/.rollup/**",
    "update-browserlist": "npx update-browserslist-db@latest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RobinHerbots/Inputmask.git"
  },
  "keywords": [
    "form",
    "input",
    "inputmask",
    "jquery",
    "jquery-plugin",
    "mask",
    "plugins"
  ],
  "author": {
    "name": "Robin Herbots",
    "url": "https://github.com/RobinHerbots"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RobinHerbots/Inputmask/issues"
  },
  "homepage": "https://github.com/RobinHerbots/Inputmask",
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^9.39.5",
    "@robinherbots/grunt-available-tasks": "^0.6.4",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/pluginutils": "^5.4.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "chokidar": "^3.6.0",
    "circular-dependency-plugin": "^5.2.2",
    "core-js": "3.50.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^65.3.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.12.0",
    "grunt": "^1.6.2",
    "grunt-bump": "^0.8.0",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-eslint": "^26.0.0",
    "grunt-karma": "^4.0.2",
    "grunt-shell": "^4.0.0",
    "grunt-webpack": "^8.0.0",
    "jquery": "^3.7.1",
    "jsdom": "^30.1.2",
    "karma": "^6.4.4",
    "karma-browserstack-launcher": "^1.6.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-jsdom-launcher": "^22.0.0",
    "karma-qunit": "^4.2.1",
    "load-grunt-tasks": "^5.1.0",
    "lodash": "^4.18.1",
    "prettier": "3.9.6",
    "qunit": "^2.26.0",
    "rollup": "^4.64.12",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^5.9.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "allowScripts": {
    "core-js@3.50.0": true,
    "unrs-resolver@1.12.2": true
  }
}
