# Add following line to your local .env file to deploy to Azure SWA from within VS code

# Read by the Gruntfile, so these apply to "grunt nugetpack"/"grunt nugetpush"
# and to "grunt publish"/"grunt publishnext". Create a key at
# https://www.nuget.org/account/apikeys
NUGET_API_KEY=

# Optional, overrides the feed the packages are pushed to, e.g. a local folder
# NUGET_SOURCE=
